---
# vault/secrets.yml.example
#
# TEMPLATE — copy to vault/secrets.yml and encrypt:
#   ansible-vault encrypt vault/secrets.yml --vault-password-file .vault_pass
#
# NEVER commit vault/secrets.yml to git (it is in .gitignore)
# This example file shows the required variable names with placeholder values.

# ── FreeIPA ──────────────────────────────────────────────────
vault_ipa_admin_password:       "CHANGE_ME_ipa_admin"
vault_ipa_ds_password:          "CHANGE_ME_ipa_ds"
vault_ipa_admin_principal:      "admin"

# ── Keycloak ─────────────────────────────────────────────────
vault_keycloak_admin_user:      "admin"
vault_keycloak_admin_password:  "CHANGE_ME_keycloak_admin"
vault_keycloak_db_password:     "CHANGE_ME_keycloak_db"
vault_keycloak_ldap_bind_pass:  "CHANGE_ME_keycloak_ldap"

# ── PostgreSQL ───────────────────────────────────────────────
vault_pg_postgres_password:     "CHANGE_ME_postgres_superuser"
vault_pg_keycloak_pass:         "CHANGE_ME_pg_keycloak"
vault_pg_nextcloud_pass:        "CHANGE_ME_pg_nextcloud"
vault_pg_mattermost_pass:       "CHANGE_ME_pg_mattermost"
vault_pg_zammad_pass:           "CHANGE_ME_pg_zammad"
vault_pg_suitecrm_pass:         "CHANGE_ME_pg_suitecrm"
vault_pg_odoo_pass:             "CHANGE_ME_pg_odoo"
vault_pg_openkm_pass:           "CHANGE_ME_pg_openkm"
vault_pg_taiga_pass:            "CHANGE_ME_pg_taiga"
vault_pg_snipeit_pass:          "CHANGE_ME_pg_snipeit"
vault_pg_glpi_pass:             "CHANGE_ME_pg_glpi"
vault_pg_zabbix_pass:           "CHANGE_ME_pg_zabbix"

# ── Redis ────────────────────────────────────────────────────
vault_redis_password:           "CHANGE_ME_redis"

# ── Traefik ──────────────────────────────────────────────────
vault_traefik_dashboard_user:   "admin"
vault_traefik_dashboard_pass:   "CHANGE_ME_traefik_dashboard"   # htpasswd hash

# ── FreeIPA service account passwords ────────────────────────
vault_svc_keycloak_pass:        "CHANGE_ME_svc_keycloak"
vault_svc_nextcloud_pass:       "CHANGE_ME_svc_nextcloud"
vault_svc_mattermost_pass:      "CHANGE_ME_svc_mattermost"
vault_svc_zabbix_pass:          "CHANGE_ME_svc_zabbix"

# ── SMTP relay (for Ansible notifications) ───────────────────
vault_smtp_host:                "10.0.50.14"
vault_smtp_port:                587
vault_smtp_user:                "ansible@example.com"
vault_smtp_password:            "CHANGE_ME_smtp"

# ── Nextcloud ────────────────────────────────────────────────
vault_nextcloud_admin_pass:     "CHANGE_ME_nextcloud_admin"

# ── Mattermost ───────────────────────────────────────────────
vault_mattermost_admin_pass:    "CHANGE_ME_mattermost_admin"

# ── Jitsi ────────────────────────────────────────────────────
vault_jitsi_jicofo_pass:        "CHANGE_ME_jitsi_jicofo"
vault_jitsi_jvb_pass:           "CHANGE_ME_jitsi_jvb"
vault_jitsi_jwt_secret:         "CHANGE_ME_jitsi_jwt_64chars"

# ── iRedMail ─────────────────────────────────────────────────
vault_iredmail_admin_pass:      "CHANGE_ME_iredmail_admin"
vault_pg_iredmail_pass:         "CHANGE_ME_pg_iredmail"

# ── Zammad ───────────────────────────────────────────────────
vault_zammad_secret_key_base:   "CHANGE_ME_zammad_secret_128chars"

# ── Elasticsearch ────────────────────────────────────────────
vault_elasticsearch_password:   "CHANGE_ME_elasticsearch_elastic"

# ── FreePBX ──────────────────────────────────────────────────
vault_freepbx_admin_pass:       "CHANGE_ME_freepbx_admin"
vault_freepbx_db_pass:          "CHANGE_ME_freepbx_db"

# ── SuiteCRM ─────────────────────────────────────────────────
vault_suitecrm_admin_pass:      "CHANGE_ME_suitecrm_admin"

# ── Odoo ─────────────────────────────────────────────────────
vault_odoo_admin_pass:          "CHANGE_ME_odoo_admin"
vault_odoo_master_pass:         "CHANGE_ME_odoo_master"

# ── OpenKM ───────────────────────────────────────────────────
vault_openkm_admin_pass:        "CHANGE_ME_openkm_admin"

# ── Taiga ────────────────────────────────────────────────────
vault_taiga_secret_key:         "CHANGE_ME_taiga_secret_50chars"
vault_taiga_admin_pass:         "CHANGE_ME_taiga_admin"

# ── Snipe-IT ─────────────────────────────────────────────────
vault_snipeit_app_key:          "CHANGE_ME_snipeit_base64_32bytes"   # base64_32_random_bytes
vault_snipeit_admin_pass:       "CHANGE_ME_snipeit_admin"

# ── GLPI ─────────────────────────────────────────────────────
vault_glpi_admin_pass:          "CHANGE_ME_glpi_admin"

# ── Zabbix ───────────────────────────────────────────────────
vault_zabbix_admin_pass:        "CHANGE_ME_zabbix_admin"

# ── Graylog ──────────────────────────────────────────────────
# password_secret:  pwgen -N 1 -s 96
# root_password_sha2: echo -n <password> | shasum -a 256 | cut -d" " -f1
vault_graylog_password_secret:      "CHANGE_ME_graylog_96char_random_secret"
vault_graylog_root_password_sha2:   "CHANGE_ME_sha256_of_root_password"

# ── TLS / Internal CA (playbooks/tls-setup.yml) ───────────────────────────────
# Generate with: openssl rand -base64 32
vault_internal_ca_passphrase:           "CHANGE_ME_internal_ca_passphrase"

# ── Backup encryption (playbooks/backup.yml) ──────────────────────────────────
# GPG key ID for encrypting config archives. Leave empty to skip encryption.
# Create with: gpg --full-generate-key   then: gpg --list-keys
vault_backup_gpg_key_id:                ""   # e.g. "admin@example.com" or key fingerprint

# ── SSH authorized keys (playbooks/harden.yml) ────────────────────────────────
# List of public keys allowed to SSH as the ansible user on all servers.
# Format: list of strings, each a full public key line.
# Generate with: ssh-keygen -t ed25519 -C "your_email@example.com"
vault_ssh_authorized_keys:
  - "CHANGE_ME_ssh_ed25519_AAAA... operator@workstation"
  # - "ssh-ed25519 AAAA...  admin2@laptop"

# ── Integration API secrets ───────────────────────────────────────────────────
# INT-14: SuiteCRM ↔ OpenKM
vault_suitecrm_url:                     "https://crm.example.com"
vault_suitecrm_api_user:                "admin"
vault_suitecrm_api_password:            "CHANGE_ME_suitecrm_api"
vault_openkm_url:                       "https://dms.example.com/OpenKM"
vault_openkm_api_user:                  "okmAdmin"
vault_openkm_api_password:              "CHANGE_ME_openkm_api"

# INT-15: Odoo ↔ FreeIPA LDAP sync
vault_ipa_ldap_bind_dn:                 "uid=odoo-svc,cn=users,cn=accounts,dc=example,dc=com"
vault_ipa_ldap_bind_pass:               "CHANGE_ME_ipa_odoo_svc"

# INT-16: Odoo ↔ Taiga time tracking
vault_taiga_url:                        "https://projects.example.com"
vault_taiga_api_user:                   "admin"
vault_taiga_api_password:               "CHANGE_ME_taiga_api"
vault_odoo_url:                         "http://lab-biz1:8069"
vault_odoo_api_db:                      "odoo"
vault_odoo_api_user:                    "admin"
vault_odoo_api_password:                "CHANGE_ME_odoo_api"

# INT-17: Odoo ↔ Snipe-IT asset sync
vault_snipeit_url:                      "https://assets.example.com"
vault_snipeit_api_token:                "CHANGE_ME_snipeit_api_token"

# INT-18: Taiga ↔ Mattermost webhook
vault_mattermost_webhook_url_taiga:     "https://chat.example.com/hooks/CHANGE_ME_taiga_hook"

# INT-19: Snipe-IT ↔ GLPI asset sync
vault_glpi_url:                         "https://itsm.example.com"
vault_glpi_api_token:                   "CHANGE_ME_glpi_api_token"
vault_glpi_app_token:                   "CHANGE_ME_glpi_app_token"

# INT-20: GLPI ↔ Zammad escalation
vault_zammad_url:                       "https://desk.example.com"
vault_zammad_api_token:                 "CHANGE_ME_zammad_api_token"

# INT-21: OpenKM ↔ Nextcloud storage backend
vault_nextcloud_url:                    "https://cloud.example.com"
vault_nextcloud_api_user:               "admin"
vault_nextcloud_api_password:           "CHANGE_ME_nextcloud_api"

# INT-22: Zabbix ↔ Mattermost alerts
vault_mattermost_webhook_url_zabbix:    "https://chat.example.com/hooks/CHANGE_ME_zabbix_hook"

# INT-23: Graylog ↔ Zabbix alert correlation
vault_zabbix_url:                       "https://zabbix.example.com"
vault_zabbix_api_user:                  "Admin"
vault_zabbix_api_password:              "CHANGE_ME_zabbix_api"
