---
# vault/secrets.yml.example
#
# TEMPLATE — copy to vault/secrets.yml and encrypt:
#   ansible-vault encrypt vault/secrets.yml --vault-password-file .vault_pass
#
# NEVER commit vault/secrets.yml to git (it is in .gitignore)
# This example file shows the required variable names with placeholder values.

# ── FreeIPA ──────────────────────────────────────────────────
vault_ipa_admin_password:       "CHANGE_ME_ipa_admin"
vault_ipa_ds_password:          "CHANGE_ME_ipa_ds"
vault_ipa_admin_principal:      "admin"

# ── Keycloak ─────────────────────────────────────────────────
vault_keycloak_admin_user:      "admin"
vault_keycloak_admin_password:  "CHANGE_ME_keycloak_admin"
vault_keycloak_db_password:     "CHANGE_ME_keycloak_db"
vault_keycloak_ldap_bind_pass:  "CHANGE_ME_keycloak_ldap"

# ── PostgreSQL ───────────────────────────────────────────────
vault_pg_postgres_password:     "CHANGE_ME_postgres_superuser"
vault_pg_keycloak_pass:         "CHANGE_ME_pg_keycloak"
vault_pg_nextcloud_pass:        "CHANGE_ME_pg_nextcloud"
vault_pg_mattermost_pass:       "CHANGE_ME_pg_mattermost"
vault_pg_zammad_pass:           "CHANGE_ME_pg_zammad"
vault_pg_suitecrm_pass:         "CHANGE_ME_pg_suitecrm"
vault_pg_odoo_pass:             "CHANGE_ME_pg_odoo"
vault_pg_openkm_pass:           "CHANGE_ME_pg_openkm"
vault_pg_taiga_pass:            "CHANGE_ME_pg_taiga"
vault_pg_snipeit_pass:          "CHANGE_ME_pg_snipeit"
vault_pg_glpi_pass:             "CHANGE_ME_pg_glpi"
vault_pg_zabbix_pass:           "CHANGE_ME_pg_zabbix"

# ── Redis ────────────────────────────────────────────────────
vault_redis_password:           "CHANGE_ME_redis"

# ── Traefik ──────────────────────────────────────────────────
vault_traefik_dashboard_user:   "admin"
vault_traefik_dashboard_pass:   "CHANGE_ME_traefik_dashboard"   # htpasswd hash

# ── FreeIPA service account passwords ────────────────────────
vault_svc_keycloak_pass:        "CHANGE_ME_svc_keycloak"
vault_svc_nextcloud_pass:       "CHANGE_ME_svc_nextcloud"
vault_svc_mattermost_pass:      "CHANGE_ME_svc_mattermost"
vault_svc_zabbix_pass:          "CHANGE_ME_svc_zabbix"

# ── SMTP relay (for Ansible notifications) ───────────────────
vault_smtp_host:                "10.0.50.14"
vault_smtp_port:                587
vault_smtp_user:                "ansible@example.com"
vault_smtp_password:            "CHANGE_ME_smtp"
