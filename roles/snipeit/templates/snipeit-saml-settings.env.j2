{# snipeit-saml-settings.env.j2 #}
{# IT-Stack: Snipe-IT SAML 2.0 settings via Keycloak (INT-08b)             #}
{# This file is sourced / merged into the Snipe-IT .env during deployment.  #}
{# Variables are set by roles/snipeit/tasks/keycloak-saml.yml (Step 3).     #}

# =============================================================================
# SAML2 / Keycloak integration — Ansible managed (INT-08b)
# =============================================================================

# Enable SAML2 authentication
SAML2_ENABLED=true

# IdP metadata auto-load from Keycloak
SAML2_AUTOLOAD_METADATA=true
SAML2_IDP_METADATA_URL={{ _snipeit_saml_metadata_url }}

# SP entity ID and ACS / SLO URLs
SAML2_SP_ENTITY_ID={{ _snipeit_saml_sp_entity_id }}
SAML2_SP_ACS_URL={{ _snipeit_saml_sp_acs_url }}
SAML2_SP_SLO_URL={{ _snipeit_saml_sp_slo_url }}

# IdP endpoints (also set for non-metadata fallback)
SAML2_IDP_ENTITYID={{ _snipeit_saml_idp_entityid }}
SAML2_IDP_SSO_URL={{ _snipeit_saml_idp_sso_url }}
SAML2_IDP_SLO_URL={{ _snipeit_saml_idp_slo_url }}

# IdP signing certificate (stripped PEM, no headers)
SAML2_IDP_x509={{ _snipeit_saml_x509 }}

# TLS verification (set false in lab; true in production)
SAML2_VERIFY_SSL={{ snipeit_tls_verify | default(false) | string | lower }}

# NameID format: the KC SAML client uses uid as NameID (username format)
SAML2_NAME_ID_FORMAT=urn:oasis:names:tc:SAML:1.1:nameid-format:unspecified

# Attribute mapping: KC sends uid / email / displayName
SAML2_LOGIN_FIELD=username
SAML2_ATTR_USERNAME=uid
SAML2_ATTR_EMAIL=email
SAML2_ATTR_FIRSTNAME=givenName
SAML2_ATTR_LASTNAME=sn

# Keycloak context (also used by Snipe-IT LDAP sync)
KEYCLOAK_URL={{ snipeit_keycloak_url }}
KEYCLOAK_REALM={{ snipeit_keycloak_realm }}
KEYCLOAK_CLIENT_ID={{ snipeit_saml_client_id | default('snipeit') }}
