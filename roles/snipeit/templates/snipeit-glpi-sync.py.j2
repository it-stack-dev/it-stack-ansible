#!/usr/bin/env python3
"""
IT-Stack INT-19: Snipe-IT ↔ GLPI bidirectional asset/CMDB sync
Generated by Ansible template: snipeit-glpi-sync.py.j2

Direction: Snipe-IT (source of truth for hardware assets) → GLPI (CMDB)
  - Creates/updates Computer/Network Equipment items in GLPI
  - Marks items decommissioned in GLPI when deleted in Snipe-IT
"""

import json
import logging
import os
import sys
import time
import urllib.request
import urllib.error
from datetime import datetime, timezone

# ── Configuration ─────────────────────────────────────────────────────────────
SNIPEIT_BASE        = "{{ _snipeit_api_url }}"
SNIPEIT_TOKEN       = "{{ _snipeit_api_key }}"

GLPI_BASE           = "{{ _snipeit_glpi_url }}"
GLPI_APP_TOKEN      = "{{ _snipeit_glpi_app_token }}"
GLPI_USER_TOKEN     = "{{ _snipeit_glpi_user_token }}"

LOG_FILE            = "/var/log/snipeit/glpi-sync.log"
DRY_RUN             = {{ 'True' if snipeit_glpi_dry_run | default(false) else 'False' }}
PAGE_SIZE           = 100

os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s %(levelname)-8s %(message)s",
    handlers=[logging.FileHandler(LOG_FILE), logging.StreamHandler(sys.stdout)],
)
log = logging.getLogger("snipeit-glpi")


def snipeit_get(path: str) -> dict | None:
    headers = {
        "Authorization": f"Bearer {SNIPEIT_TOKEN}",
        "Accept": "application/json",
    }
    req = urllib.request.Request(f"{SNIPEIT_BASE}/api/v1/{path}", headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:  # nosec B310
            return json.loads(resp.read().decode())
    except urllib.error.HTTPError as exc:
        log.warning("Snipe-IT GET %s → %s", path, exc.code)
        return None


def glpi_session_token() -> str | None:
    headers = {
        "App-Token": GLPI_APP_TOKEN,
        "Authorization": f"user_token {GLPI_USER_TOKEN}",
    }
    req = urllib.request.Request(f"{GLPI_BASE}/apirest.php/initSession", headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:  # nosec B310
            data = json.loads(resp.read().decode())
            return data.get("session_token")
    except urllib.error.HTTPError as exc:
        log.error("GLPI initSession → HTTP %s", exc.code)
        return None


def glpi_request(method: str, path: str, session: str, data: dict = None) -> dict | list | None:
    headers = {
        "App-Token": GLPI_APP_TOKEN,
        "Session-Token": session,
        "Content-Type": "application/json",
    }
    body = json.dumps({"input": data}).encode() if data else None
    req = urllib.request.Request(
        f"{GLPI_BASE}/apirest.php/{path}",
        data=body, headers=headers, method=method,
    )
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:  # nosec B310
            return json.loads(resp.read().decode())
    except urllib.error.HTTPError as exc:
        log.warning("GLPI %s %s → %s", method, path, exc.code)
        return None


def glpi_kill_session(session: str):
    glpi_request("GET", "killSession", session)


def fetch_all_snipeit_assets() -> list:
    all_assets = []
    offset = 0
    while True:
        resp = snipeit_get(f"hardware?limit={PAGE_SIZE}&offset={offset}")
        if not resp or not resp.get("rows"):
            break
        all_assets.extend(resp["rows"])
        if len(resp["rows"]) < PAGE_SIZE:
            break
        offset += PAGE_SIZE
    return all_assets


def upsert_glpi_computer(session: str, asset: dict) -> bool:
    name       = asset.get("name", "")
    serial     = (asset.get("serial") or "").strip()
    asset_tag  = (asset.get("asset_tag") or "").strip()
    note       = f"Synced from Snipe-IT id={asset['id']} tag={asset_tag}"

    existing = glpi_request("GET", f"Computer?searchText[name]={name}&range=0-5", session)
    payload  = {
        "name":         name,
        "serial":       serial,
        "otherserial":  asset_tag,
        "comment":      note,
        "is_dynamic":   0,
    }

    if DRY_RUN:
        log.info("[DRY-RUN] Would upsert GLPI computer: %s", name)
        return True

    if isinstance(existing, list) and existing:
        item_id = existing[0]["id"]
        glpi_request("PUT", f"Computer/{item_id}", session, payload)
        log.debug("Updated GLPI Computer id=%s name=%s", item_id, name)
    else:
        glpi_request("POST", "Computer", session, payload)
        log.debug("Created GLPI Computer: %s", name)
    return True


def main():
    log.info("INT-19: Snipe-IT↔GLPI sync — %s", datetime.now(timezone.utc).isoformat())

    session = glpi_session_token()
    if not session:
        log.error("Cannot obtain GLPI session token — aborting")
        sys.exit(1)

    assets = fetch_all_snipeit_assets()
    log.info("Fetched %d assets from Snipe-IT", len(assets))

    success, errors = 0, 0
    for asset in assets:
        try:
            upsert_glpi_computer(session, asset)
            success += 1
        except Exception as exc:  # noqa: BLE001
            log.error("Error syncing asset %s: %s", asset.get("id"), exc)
            errors += 1
        time.sleep(0.05)

    glpi_kill_session(session)
    log.info("INT-19 complete — %d synced, %d errors", success, errors)
    if errors:
        sys.exit(1)


if __name__ == "__main__":
    main()
