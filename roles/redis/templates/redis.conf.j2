# /etc/redis/redis.conf — Managed by Ansible (roles/redis)
# {{ ansible_managed }}

# ── Network ──────────────────────────────────────────────────
bind 127.0.0.1 {{ redis_bind }}
port {{ redis_port }}
tcp-backlog 511
timeout 0
tcp-keepalive 300
protected-mode yes

# ── Security ─────────────────────────────────────────────────
requirepass {{ vault_redis_password }}
rename-command FLUSHALL ""
rename-command FLUSHDB  ""
rename-command DEBUG    ""
rename-command CONFIG   "CONFIG_ADMIN_{{ vault_redis_password | hash('sha1') | truncate(8, True, '') }}"

# ── Memory ───────────────────────────────────────────────────
maxmemory {{ redis_maxmemory }}
maxmemory-policy {{ redis_maxmemory_policy }}

# ── Persistence ──────────────────────────────────────────────
{% for save_rule in redis_save %}
save {{ save_rule }}
{% endfor %}
stop-writes-on-bgsave-error yes
rdbcompression yes
rdbchecksum yes
dbfilename dump.rdb
dir /var/lib/redis

appendonly {{ redis_appendonly }}
appendfilename "appendonly.aof"
appendfsync everysec
no-appendfsync-on-rewrite no
auto-aof-rewrite-percentage 100
auto-aof-rewrite-min-size 64mb

# ── Logging ──────────────────────────────────────────────────
loglevel {{ redis_loglevel }}
logfile {{ redis_logfile }}
databases {{ redis_databases }}

# ── Performance ──────────────────────────────────────────────
hz 10
aof-rewrite-incremental-fsync yes
