)
log = logging.getLogger("suitecrm-odoo-sync")


# ---------------------------------------------------------------------------
# Odoo JSON-RPC helpers
# ---------------------------------------------------------------------------
_rpc_id = 0

def _odoo_call(endpoint, method, params, timeout=20):
    """Make a JSON-RPC call to Odoo. Returns parsed result or raises."""
    global _rpc_id
    _rpc_id += 1
    payload = json.dumps({
        "jsonrpc": "2.0",
        "method":  "call",
        "id":      _rpc_id,
        "params":  params,
    }).encode("utf-8")
    url  = ODOO_URL.rstrip("/") + endpoint
    req  = urllib.request.Request(
        url, data=payload,
        headers={"Content-Type": "application/json"},
        method=method,
    )
    if not VERIFY_TLS:
        import ssl
        ctx = ssl.create_default_context()
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
    else:
        ctx = None
    try:
        with urllib.request.urlopen(req, context=ctx, timeout=timeout) as resp:
            body = json.loads(resp.read().decode("utf-8"))
        if "error" in body:
            raise RuntimeError(f"Odoo RPC error: {body['error']}")
        return body.get("result")
    except urllib.error.HTTPError as exc:
        raise RuntimeError(f"HTTP {exc.code} from Odoo at {url}") from exc
    except urllib.error.URLError as exc:
        raise RuntimeError(f"Network error reaching Odoo at {url}: {exc.reason}") from exc


def odoo_authenticate():
    """Return Odoo user ID and session cookie. Raises on failure."""
    result = _odoo_call(
        "/web/session/authenticate", "POST",
        {"db": ODOO_DB, "login": ODOO_USER, "password": ODOO_API_KEY},
    )
    uid = result.get("uid") if result else None
    if not uid:
        raise RuntimeError(f"Odoo authentication failed for user={ODOO_USER} db={ODOO_DB}")
    log.info("Odoo authenticated: uid=%s", uid)
    return uid


def odoo_search_partners(uid, domain=None, fields=None, limit=500):
    """Return list of res.partner dicts from Odoo."""
    domain = domain or [["is_company", "=", True], ["active", "=", True]]
    fields = fields or ["id", "name", "email", "phone", "website", "street", "city", "country_id"]
    result = _odoo_call(
        "/web/dataset/call_kw", "POST",
        {
            "model":  "res.partner",
            "method": "search_read",
            "args":   [domain],
            "kwargs": {"fields": fields, "limit": limit},
        },
    )
    return result or []


def odoo_create_partner(uid, values):
    """Create a res.partner in Odoo. Returns new record ID."""
    result = _odoo_call(
        "/web/dataset/call_kw", "POST",
        {
            "model":  "res.partner",
            "method": "create",
            "args":   [values],
            "kwargs": {},
        },
    )
    return result


def odoo_write_partner(uid, partner_id, values):
    """Update a res.partner in Odoo. Returns True on success."""
    result = _odoo_call(
        "/web/dataset/call_kw", "POST",
        {
            "model":  "res.partner",
            "method": "write",
            "args":   [[partner_id], values],
            "kwargs": {},
        },
    )
    return result


