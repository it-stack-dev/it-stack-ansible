ODOO_URL      = "{{ _suitecrm_odoo_url }}"
ODOO_DB       = "{{ _suitecrm_odoo_db }}"
ODOO_USER     = "{{ _suitecrm_odoo_user }}"
ODOO_API_KEY  = "{{ _suitecrm_odoo_api_key }}"
