#!/usr/bin/env python3
"""
IT-Stack INT-14: SuiteCRM ↔ OpenKM document linking sync script
Generated by Ansible template: suitecrm-openkm-docs.py.j2

Connects CRM contacts/accounts to their related OpenKM document folder,
creating the folder structure if missing under:
  /okm:root/crm/{{ suitecrm_openkm_folder | default('suitecrm') }}/
"""

import json
import logging
import os
import sys
import time
import urllib.parse
import urllib.request
import urllib.error
from datetime import datetime, timezone

# ── Configuration ─────────────────────────────────────────────────────────────
OPENKM_BASE          = "{{ _openkm_url }}"
OPENKM_USER          = "{{ _suitecrm_openkm_user }}"
OPENKM_PASS          = "{{ _suitecrm_openkm_pass }}"
OPENKM_ROOT_FOLDER   = "/okm:root/crm/{{ suitecrm_openkm_folder | default('suitecrm') }}"

SUITECRM_BASE        = "{{ suitecrm_base_url | default('http://crm.lab.local') }}"
SUITECRM_USER        = "{{ suitecrm_admin_user | default('admin') }}"
SUITECRM_PASS        = "{{ vault_suitecrm_admin_pass | default('Lab14Admin!') }}"

LOG_FILE             = "/var/log/suitecrm/openkm-docs.log"
DRY_RUN              = {{ 'True' if suitecrm_openkm_dry_run | default(false) else 'False' }}

# ── Logging setup ─────────────────────────────────────────────────────────────
os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s %(levelname)-8s %(message)s",
    handlers=[logging.FileHandler(LOG_FILE), logging.StreamHandler(sys.stdout)],
)
log = logging.getLogger("crm-okm-sync")


def _request(url: str, data=None, method: str = "GET",
             headers: dict = None, auth=None) -> dict | str | None:
    """Minimal HTTP helper (no third-party deps)."""
    req_headers = {"Content-Type": "application/json", "Accept": "application/json"}
    if headers:
        req_headers.update(headers)
    if auth:
        import base64
        creds = base64.b64encode(f"{auth[0]}:{auth[1]}".encode()).decode()
        req_headers["Authorization"] = f"Basic {creds}"
    body = json.dumps(data).encode() if data else None
    req = urllib.request.Request(url, data=body, headers=req_headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:  # nosec B310
            raw = resp.read().decode()
            try:
                return json.loads(raw)
            except json.JSONDecodeError:
                return raw
    except urllib.error.HTTPError as exc:
        log.warning("HTTP %s %s → %s", method, url, exc.code)
        return None


def openkm_token() -> str | None:
    """Obtain an OpenKM session token."""
    resp = _request(
        f"{OPENKM_BASE}/services/rest/auth/login",
        auth=(OPENKM_USER, OPENKM_PASS),
    )
    return resp if isinstance(resp, str) else None


def ensure_okm_folder(token: str, path: str) -> bool:
    """Create OpenKM folder path if it doesn't exist."""
    headers = {"Authorization": f"Bearer {token}"}
    existing = _request(f"{OPENKM_BASE}/services/rest/folder/exists?path={urllib.parse.quote(path)}",
                        headers=headers)
    if existing is True:
        return True
    if DRY_RUN:
        log.info("[DRY-RUN] Would create folder: %s", path)
        return True
    parts = path.split("/")
    current = ""
    for part in parts:
        if not part:
            continue
        current = f"{current}/{part}"
        _request(f"{OPENKM_BASE}/services/rest/folder/create",
                 data={"path": current}, method="POST", headers=headers)
    return True


def suitecrm_oauth_token() -> str | None:
    """Get SuiteCRM V8 OAuth2 token."""
    payload = {
        "grant_type": "password",
        "client_id": "sugar",
        "client_secret": "",
        "username": SUITECRM_USER,
        "password": SUITECRM_PASS,
    }
    resp = _request(f"{SUITECRM_BASE}/index.php/api/oauth2/token", data=payload, method="POST")
    if isinstance(resp, dict):
        return resp.get("access_token")
    return None


def fetch_accounts(crm_token: str) -> list:
    """Fetch all Account records with external IDs."""
    headers = {"Authorization": f"Bearer {crm_token}"}
    resp = _request(f"{SUITECRM_BASE}/index.php/api/v8/modules/Accounts?fields[Accounts]=name,id",
                    headers=headers)
    if isinstance(resp, dict):
        return resp.get("data", [])
    return []


def sync_account_folder(token_okm: str, account_id: str, account_name: str):
    """Make sure an OpenKM folder exists for this CRM account."""
    safe_name = account_name.replace("/", "_").replace("\\", "_")
    folder_path = f"{OPENKM_ROOT_FOLDER}/{safe_name}-{account_id[:8]}"
    ensure_okm_folder(token_okm, folder_path)
    log.info("Ensured folder: %s", folder_path)


def main():
    log.info("IT-Stack INT-14: SuiteCRM↔OpenKM sync — started %s",
             datetime.now(timezone.utc).isoformat())

    token_okm = openkm_token()
    if not token_okm:
        log.error("Cannot obtain OpenKM session token — aborting")
        sys.exit(1)

    ensure_okm_folder(token_okm, OPENKM_ROOT_FOLDER)

    crm_token = suitecrm_oauth_token()
    if not crm_token:
        log.error("Cannot obtain SuiteCRM OAuth2 token — aborting")
        sys.exit(1)

    accounts = fetch_accounts(crm_token)
    log.info("Fetched %d accounts from SuiteCRM", len(accounts))

    success, errors = 0, 0
    for acct in accounts:
        try:
            acct_id   = acct["id"]
            acct_name = acct.get("attributes", {}).get("name", acct_id)
            sync_account_folder(token_okm, acct_id, acct_name)
            success += 1
        except Exception as exc:  # noqa: BLE001
            log.error("Error syncing account %s: %s", acct.get("id"), exc)
            errors += 1
        time.sleep(0.05)

    log.info("INT-14 complete — synced %d accounts, %d errors", success, errors)
    if errors:
        sys.exit(1)


if __name__ == "__main__":
    main()
