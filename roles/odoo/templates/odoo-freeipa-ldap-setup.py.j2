#!/usr/bin/env python3
"""
IT-Stack INT-15: Odoo ↔ FreeIPA LDAP sync script
Generated by Ansible template: odoo-freeipa-ldap-setup.py.j2
Run via: odoo-bin shell < /opt/odoo/scripts/odoo-freeipa-ldap-setup.py
"""

import configparser
import logging
import os
import sys
from pathlib import Path

CONFIG_FILE = "/opt/odoo/scripts/freeipa-ldap.ini"
LOG_FILE    = "/var/log/odoo/freeipa-ldap-sync.log"

os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s %(levelname)-8s %(message)s",
    handlers=[logging.FileHandler(LOG_FILE), logging.StreamHandler(sys.stdout)],
)
log = logging.getLogger("odoo-freeipa")


def load_config(path: str) -> configparser.ConfigParser:
    cfg = configparser.ConfigParser()
    if not Path(path).exists():
        log.error("Config file not found: %s", path)
        sys.exit(1)
    cfg.read(path)
    return cfg


def ensure_ldap_server(env, cfg) -> object:
    """Create or update res.company.ldaps record in Odoo."""
    CompanyLdap = env["res.company.ldaps"]
    Company     = env["res.company"]
    company     = Company.search([("id", ">", 0)], limit=1)

    base_dn    = cfg.get("auth", "base_dn")
    server     = cfg.get("ldap", "server_host")
    port       = cfg.getint("ldap", "server_port")
    bind_dn    = cfg.get("auth", "bind_dn")
    bind_pass  = cfg.get("auth", "bind_pass")
    user_filter = cfg.get("filter", "user_filter")
    login_attr = cfg.get("mapping", "login_attr")

    existing = CompanyLdap.search([("ldap_server", "=", server)], limit=1)

    vals = {
        "company": company.id,
        "ldap_server": server,
        "ldap_server_port": port,
        "ldap_tls": cfg.getboolean("ldap", "use_tls"),
        "ldap_base": base_dn,
        "ldap_binddn": bind_dn,
        "ldap_password": bind_pass,
        "ldap_filter": user_filter,
        "ldap_login_attribute": login_attr,
        "create_user": cfg.getboolean("sync", "create_users"),
    }

    if existing:
        existing.write(vals)
        log.info("Updated LDAP server record for %s", server)
        return existing
    else:
        record = CompanyLdap.create(vals)
        log.info("Created LDAP server record for %s (id=%s)", server, record.id)
        return record


def sync_users(env, ldap_record) -> tuple[int, int]:
    """Trigger population sync and return (created, updated)."""
    Users = env["res.users"]
    before = Users.search_count([])
    try:
        ldap_record.action_sync_users()
        after = Users.search_count([])
        created = max(after - before, 0)
        log.info("LDAP sync complete — %d users before, %d after, ~%d created",
                 before, after, created)
        return created, 0
    except Exception as exc:  # noqa: BLE001
        log.error("LDAP sync failed: %s", exc)
        return 0, 1


def main():
    log.info("INT-15: Odoo↔FreeIPA LDAP setup — starting")
    cfg = load_config(CONFIG_FILE)

    # 'env' is injected by odoo-bin shell
    try:
        env  # noqa: B018
    except NameError:
        log.error("This script must be run via: odoo-bin shell < <script>")
        sys.exit(1)

    ldap_rec = ensure_ldap_server(env, cfg)  # noqa: F821
    created, errors = sync_users(env, ldap_rec)

    env.cr.commit()  # noqa: F821
    log.info("INT-15 complete — users created: %d, errors: %d", created, errors)


main()
