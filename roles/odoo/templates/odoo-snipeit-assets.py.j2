#!/usr/bin/env python3
"""
IT-Stack INT-17: Odoo ↔ Snipe-IT asset procurement sync
Generated by Ansible template: odoo-snipeit-assets.py.j2

Reads Odoo purchase orders that have been confirmed/received and
creates or updates matching asset records in Snipe-IT.
"""

import json
import logging
import os
import sys
import time
import urllib.request
import urllib.error
import xmlrpc.client
from datetime import datetime, timezone

# ── Configuration ─────────────────────────────────────────────────────────────
SNIPEIT_BASE        = "{{ _odoo_snipeit_url }}"
SNIPEIT_TOKEN       = "{{ _odoo_snipeit_api_key }}"
SNIPEIT_STATUS_ID   = {{ _odoo_snipeit_status_id }}

ODOO_BASE           = "{{ odoo_base_url | default('http://erp.lab.local:8069') }}"
ODOO_DB             = "{{ odoo_db_name | default('odoo') }}"
ODOO_USER           = "{{ odoo_admin_user | default('admin') }}"
ODOO_PASS           = "{{ vault_odoo_admin_pass | default('Lab17OdooPass!') }}"

LOG_FILE            = "/var/log/odoo/snipeit-assets.log"
DRY_RUN             = {{ 'True' if odoo_snipeit_dry_run | default(false) else 'False' }}

os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s %(levelname)-8s %(message)s",
    handlers=[logging.FileHandler(LOG_FILE), logging.StreamHandler(sys.stdout)],
)
log = logging.getLogger("odoo-snipeit")


def odoo_call(service: str, method: str, args: list):
    proxy = xmlrpc.client.ServerProxy(f"{ODOO_BASE}/xmlrpc/2/{service}", allow_none=True)
    return getattr(proxy, method)(*args)


def odoo_uid() -> int:
    return odoo_call("common", "authenticate", [ODOO_DB, ODOO_USER, ODOO_PASS, {}])


def fetch_confirmed_po_lines(uid: int) -> list:
    """Return purchase order lines for hardware product category."""
    lines = odoo_call("object", "execute_kw", [
        ODOO_DB, uid, ODOO_PASS,
        "purchase.order.line", "search_read",
        [[["order_id.state", "in", ["purchase", "done"]],
          ["product_id.categ_id.name", "ilike", "hardware"]]],
        {"fields": ["product_id", "product_qty", "order_id", "date_approve"],
         "limit": 500}
    ])
    return lines or []


def snipeit_request(method: str, path: str, data: dict = None) -> dict | None:
    url = f"{SNIPEIT_BASE}/api/v1/{path}"
    headers = {
        "Authorization": f"Bearer {SNIPEIT_TOKEN}",
        "Accept": "application/json",
        "Content-Type": "application/json",
    }
    body = json.dumps(data).encode() if data else None
    req = urllib.request.Request(url, data=body, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:  # nosec B310
            return json.loads(resp.read().decode())
    except urllib.error.HTTPError as exc:
        log.warning("%s %s → HTTP %s", method, url, exc.code)
        return None


def find_or_create_asset(product_name: str, serial: str, qty: int, purchase_date: str) -> bool:
    existing = snipeit_request("GET", f"hardware?search={urllib.parse.quote(product_name)}&limit=50")
    if existing and existing.get("total", 0) > 0:
        for row in existing["rows"]:
            if row.get("name", "").lower() == product_name.lower():
                log.info("Asset already exists: %s", product_name)
                return True

    if DRY_RUN:
        log.info("[DRY-RUN] Would create asset: %s (qty=%d)", product_name, qty)
        return True

    for i in range(max(qty, 1)):
        payload = {
            "name": product_name,
            "asset_tag": f"IT-{datetime.now().strftime('%Y%m%d')}-{i:04d}",
            "status_id": SNIPEIT_STATUS_ID,
            "purchase_date": purchase_date[:10] if purchase_date else None,
        }
        resp = snipeit_request("POST", "hardware", payload)
        if resp and resp.get("status") == "success":
            log.info("Created asset: %s (asset tag %s)", product_name, payload["asset_tag"])
        else:
            log.warning("Failed to create asset: %s", product_name)
            return False
        time.sleep(0.1)
    return True


import urllib.parse  # noqa: E402


def main():
    log.info("INT-17: Odoo↔Snipe-IT asset sync — %s", datetime.now(timezone.utc).isoformat())

    uid = odoo_uid()
    if not uid:
        log.error("Odoo authentication failed — aborting")
        sys.exit(1)

    lines = fetch_confirmed_po_lines(uid)
    log.info("Found %d Odoo PO lines for hardware products", len(lines))

    success, errors = 0, 0
    for line in lines:
        try:
            product_name = line["product_id"][1] if line.get("product_id") else "Unknown"
            qty  = int(line.get("product_qty", 1))
            date = (line.get("date_approve") or "")[:10]
            if find_or_create_asset(product_name, "", qty, date):
                success += 1
            else:
                errors += 1
        except Exception as exc:  # noqa: BLE001
            log.error("Error processing PO line: %s", exc)
            errors += 1

    log.info("INT-17 complete — %d synced, %d errors", success, errors)
    if errors:
        sys.exit(1)


if __name__ == "__main__":
    main()
