# IT-Stack INT-15: Odoo ↔ FreeIPA LDAP configuration
# Generated by Ansible template: odoo-freeipa-ldap.conf.j2
# Used in: odoo-freeipa-ldap-setup.py.j2  (written to /opt/odoo/scripts/freeipa-ldap.ini)

[ldap]
server_host    = {{ _odoo_freeipa_ldap_host }}
server_port    = {{ odoo_freeipa_ldap_port | default(636) }}
use_tls        = {{ 'True' if odoo_freeipa_use_tls | default(true) else 'False' }}
tls_ca_cert    = {{ odoo_freeipa_tls_ca | default('/etc/ssl/certs/ca-certificates.crt') }}

[auth]
bind_dn        = {{ _odoo_freeipa_bind_dn }}
bind_pass      = {{ _odoo_freeipa_bind_pass }}
base_dn        = {{ _odoo_freeipa_base_dn }}

[filter]
user_filter    = {{ odoo_freeipa_user_filter | default('(&(objectClass=person)(uid=*))') }}
user_attrib    = {{ odoo_freeipa_user_attr  | default('uid') }}

[mapping]
# LDAP attribute → Odoo res.users field
name_attr      = {{ odoo_freeipa_name_attr      | default('cn') }}
email_attr     = {{ odoo_freeipa_email_attr     | default('mail') }}
login_attr     = {{ odoo_freeipa_login_attr     | default('uid') }}
phone_attr     = {{ odoo_freeipa_phone_attr     | default('telephoneNumber') }}
mobile_attr    = {{ odoo_freeipa_mobile_attr    | default('mobile') }}
job_attr       = {{ odoo_freeipa_job_attr       | default('title') }}
dept_attr      = {{ odoo_freeipa_dept_attr      | default('departmentNumber') }}

[sync]
sync_interval  = {{ odoo_freeipa_sync_interval  | default('daily') }}
create_users   = {{ 'True' if odoo_freeipa_create_users | default(true) else 'False' }}
deactivate     = {{ 'True' if odoo_freeipa_deactivate  | default(true) else 'False' }}
log_file       = /var/log/odoo/freeipa-ldap-sync.log
