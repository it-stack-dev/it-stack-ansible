#!/usr/bin/env python3
"""
IT-Stack INT-16: Odoo ↔ Taiga time tracking sync
Generated by Ansible template: odoo-taiga-timetrack.py.j2

Pulls Taiga user-story timesheets and writes them to Odoo
account.analytic.line (hr.timesheet) records.
"""

import json
import logging
import os
import sys
import time
import urllib.parse
import urllib.request
import urllib.error
from datetime import datetime, timezone, date

# ── Configuration ─────────────────────────────────────────────────────────────
TAIGA_BASE          = "{{ _odoo_taiga_url }}"
TAIGA_USER          = "{{ _odoo_taiga_user }}"
TAIGA_PASS          = "{{ _odoo_taiga_pass }}"
TAIGA_PROJECT_SLUG  = "{{ _odoo_taiga_project_slug }}"

ODOO_BASE           = "{{ odoo_base_url | default('http://erp.lab.local:8069') }}"
ODOO_DB             = "{{ odoo_db_name | default('odoo') }}"
ODOO_USER           = "{{ odoo_admin_user | default('admin') }}"
ODOO_PASS           = "{{ vault_odoo_admin_pass | default('Lab16OdooPass!') }}"

LOG_FILE            = "/var/log/odoo/taiga-timetrack.log"
DRY_RUN             = {{ 'True' if odoo_taiga_dry_run | default(false) else 'False' }}

os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s %(levelname)-8s %(message)s",
    handlers=[logging.FileHandler(LOG_FILE), logging.StreamHandler(sys.stdout)],
)
log = logging.getLogger("odoo-taiga-time")


def _post_json(url: str, data: dict, headers: dict = None) -> dict | None:
    req_headers = {"Content-Type": "application/json", "Accept": "application/json"}
    if headers:
        req_headers.update(headers)
    req = urllib.request.Request(url, data=json.dumps(data).encode(), headers=req_headers, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:  # nosec B310
            return json.loads(resp.read().decode())
    except urllib.error.HTTPError as exc:
        log.warning("POST %s → HTTP %s", url, exc.code)
        return None


def _get_json(url: str, headers: dict = None) -> dict | list | None:
    req_headers = {"Accept": "application/json"}
    if headers:
        req_headers.update(headers)
    req = urllib.request.Request(url, headers=req_headers)
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:  # nosec B310
            return json.loads(resp.read().decode())
    except urllib.error.HTTPError as exc:
        log.warning("GET %s → HTTP %s", url, exc.code)
        return None


def taiga_login() -> str | None:
    resp = _post_json(f"{TAIGA_BASE}/api/v1/auth",
                      {"type": "normal", "username": TAIGA_USER, "password": TAIGA_PASS})
    return resp.get("auth_token") if resp else None


def taiga_project_id(auth: str) -> int | None:
    resp = _get_json(f"{TAIGA_BASE}/api/v1/projects/by_slug?slug={TAIGA_PROJECT_SLUG}",
                     {"Authorization": f"Bearer {auth}"})
    return resp.get("id") if resp else None


def fetch_timesheet_entries(auth: str, project_id: int) -> list:
    url = f"{TAIGA_BASE}/api/v1/userstories?project={project_id}&include_attachments=false"
    stories = _get_json(url, {"Authorization": f"Bearer {auth}"}) or []
    entries = []
    for story in stories:
        if story.get("total_elapsed_time", 0):
            entries.append({
                "story_ref": story.get("ref"),
                "subject":   story.get("subject", ""),
                "hours":     story.get("total_elapsed_time", 0) / 3600,
                "date":      story.get("modified_date", date.today().isoformat())[:10],
            })
    return entries


def odoo_xmlrpc_call(service: str, method: str, args: list):
    """Minimal xmlrpc client — no external deps."""
    import xmlrpc.client
    url = f"{ODOO_BASE}/xmlrpc/2/{service}"
    proxy = xmlrpc.client.ServerProxy(url, allow_none=True)
    return getattr(proxy, method)(*args)


def odoo_uid() -> int:
    return odoo_xmlrpc_call("common", "authenticate", [ODOO_DB, ODOO_USER, ODOO_PASS, {}])


def write_timesheet(uid: int, entry: dict) -> int | None:
    if DRY_RUN:
        log.info("[DRY-RUN] Would write: %s %.2fh on %s", entry["subject"], entry["hours"], entry["date"])
        return None
    vals = {
        "name":       f"[Taiga #{entry['story_ref']}] {entry['subject']}",
        "unit_amount": round(entry["hours"], 2),
        "date":        entry["date"],
    }
    return odoo_xmlrpc_call("object", "execute_kw",
                            [ODOO_DB, uid, ODOO_PASS, "account.analytic.line",
                             "create", [vals], {}])


def main():
    log.info("INT-16: Odoo↔Taiga timetrack sync — %s", datetime.now(timezone.utc).isoformat())

    token = taiga_login()
    if not token:
        log.error("Cannot authenticate to Taiga — aborting")
        sys.exit(1)

    proj_id = taiga_project_id(token)
    if not proj_id:
        log.error("Project '%s' not found in Taiga — aborting", TAIGA_PROJECT_SLUG)
        sys.exit(1)

    entries = fetch_timesheet_entries(token, proj_id)
    log.info("Fetched %d time-tracked stories from Taiga", len(entries))

    uid = odoo_uid()
    if not uid:
        log.error("Cannot authenticate to Odoo — aborting")
        sys.exit(1)

    success, errors = 0, 0
    for entry in entries:
        try:
            write_timesheet(uid, entry)
            success += 1
        except Exception as exc:  # noqa: BLE001
            log.error("Error writing timesheet for story %s: %s", entry.get("story_ref"), exc)
            errors += 1
        time.sleep(0.1)

    log.info("INT-16 complete — %d entries synced, %d errors", success, errors)
    if errors:
        sys.exit(1)


if __name__ == "__main__":
    main()
