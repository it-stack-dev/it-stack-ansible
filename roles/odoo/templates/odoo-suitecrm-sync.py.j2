# ---------------------------------------------------------------------------
# HTTP helper
# ---------------------------------------------------------------------------
def _http_request(url, method="GET", data=None, headers=None, timeout=20):
    headers = headers or {}
    if data and "Content-Type" not in headers:
        headers["Content-Type"] = "application/json"
    payload = json.dumps(data).encode("utf-8") if data else None
    req = urllib.request.Request(url, data=payload, headers=headers, method=method)
    if not VERIFY_TLS:
        import ssl
        ctx = ssl.create_default_context()
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
    else:
        ctx = None
    with urllib.request.urlopen(req, context=ctx, timeout=timeout) as resp:
        return json.loads(resp.read().decode("utf-8"))


# ---------------------------------------------------------------------------
# SuiteCRM V8 REST helpers
# ---------------------------------------------------------------------------
_suitecrm_token = None


def suitecrm_authenticate():
    """Obtain OAuth2 bearer token from SuiteCRM V8."""
    global _suitecrm_token
    url = f"{SUITECRM_URL.rstrip('/')}/index.php?entryPoint=OAuth2Token"
    try:
        result = _http_request(
            url, "POST",
            data={
                "grant_type": "password",
                "client_id": "sugar",
                "client_secret": "",
                "username": SUITECRM_API_USER,
                "password": SUITECRM_API_PASS,
            },
        )
        _suitecrm_token = result.get("access_token")
        if _suitecrm_token:
            log.info("SuiteCRM V8 OAuth2 token obtained")
            return _suitecrm_token
    except Exception as exc:  # noqa: BLE001
        log.warning("SuiteCRM V8 OAuth2 failed: %s — using stub mode", exc)
    return None


def suitecrm_search_accounts(token, limit=500):
    """Return list of SuiteCRM Account records via V8 REST."""
    if not token:
        log.info("SuiteCRM token unavailable — returning stub accounts")
        return [
            {"id": "sc-001", "attributes": {"name": "Acme Corp",    "email1": "billing@acme.example", "phone_office": "555-0101"}},
            {"id": "sc-002", "attributes": {"name": "Globex LLC",   "email1": "info@globex.example",  "phone_office": "555-0102"}},
            {"id": "sc-003", "attributes": {"name": "IT-Stack Demo","email1": "demo@itstack.example", "phone_office": "555-0103"}},
        ]
    try:
        url = f"{SUITECRM_URL.rstrip('/')}/api/v8/module/Accounts?page[size]={limit}"
        result = _http_request(url, "GET", headers={"Authorization": f"Bearer {token}"})
        return result.get("data", [])
    except Exception as exc:  # noqa: BLE001
        log.error("SuiteCRM Accounts fetch failed: %s", exc)
        return []


def suitecrm_upsert_account(token, partner):
    """Create or update a SuiteCRM Account from Odoo partner data."""
    name = partner.get("name", "")
    if not token:
        log.info("SuiteCRM upsert stub: name=%s", name)
        return {"id": f"sc-stub-{hash(name) % 9999}"}
    payload = {
        "data": {
            "type": "Accounts",
            "attributes": {
                "name":          name,
                "email1":        partner.get("email", ""),
                "phone_office":  partner.get("phone", ""),
                "website":       partner.get("website", ""),
                "description":   f"Synced from Odoo INT-12",
            },
        }
    }
    try:
        url = f"{SUITECRM_URL.rstrip('/')}/api/v8/module/Accounts"
        return _http_request(url, "POST", data=payload,
                              headers={"Authorization": f"Bearer {token}",
                                       "Content-Type": "application/json"})
    except Exception as exc:  # noqa: BLE001
        log.error("SuiteCRM upsert failed for %s: %s", name, exc)
        return {}


