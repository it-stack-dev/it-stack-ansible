def main():
    ap = argparse.ArgumentParser(description="Odoo ↔ SuiteCRM customer sync (INT-12)")
    ap.add_argument("--direction", choices=["pull", "push", "both"], default="both")
    ap.add_argument("--dry-run", action="store_true")
