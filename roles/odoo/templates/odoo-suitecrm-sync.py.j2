        totals["pull"] = pull_suitecrm_to_odoo(token, dry_run=args.dry_run)
    if args.direction in ("push", "both"):
        totals["push"] = push_odoo_to_suitecrm(token, dry_run=args.dry_run)

    log.info("INT-12 Odoo↔SuiteCRM sync complete: %s", totals)


if __name__ == "__main__":
    main()
