# ---------------------------------------------------------------------------
# Sync logic
# ---------------------------------------------------------------------------
def pull_suitecrm_to_odoo(token, dry_run):
    """Pull SuiteCRM Account records and upsert to Odoo as res.partner."""
    log.info("PULL: SuiteCRM Accounts → Odoo res.partner")
    accounts = suitecrm_search_accounts(token)
    log.info("Fetched %d account(s) from SuiteCRM", len(accounts))
    created = updated = skipped = 0
    for acc in accounts:
        attrs = acc.get("attributes", acc)
        name  = attrs.get("name", "")
        if not name:
            skipped += 1
            continue
        if dry_run:
            log.info("[dry-run] Would upsert Odoo partner: %s", name)
            created += 1
            continue
        # In full deployment: call Odoo XML-RPC/JSONRPC create/write
        log.info("Odoo partner upsert: name=%s (lab stub)", name)
        created += 1
    log.info("PULL complete: created=%d updated=%d skipped=%d", created, updated, skipped)
    return {"created": created, "updated": updated, "skipped": skipped}


def push_odoo_to_suitecrm(token, dry_run):
    """Push Odoo res.partner records to SuiteCRM Accounts."""
    log.info("PUSH: Odoo res.partner → SuiteCRM Accounts")
    partners = odoo_get_partners()
    log.info("Fetched %d partner(s) from Odoo (stub)", len(partners))
    created = updated = skipped = 0
    for p in partners:
        if not p.get("is_company"):
            skipped += 1
            continue
        if dry_run:
            log.info("[dry-run] Would upsert SuiteCRM Account: %s", p.get("name"))
            created += 1
            continue
        result = suitecrm_upsert_account(token, p)
        if result.get("id"):
            created += 1
    log.info("PUSH complete: created=%d updated=%d skipped=%d", created, updated, skipped)
    return {"created": created, "updated": updated, "skipped": skipped}


