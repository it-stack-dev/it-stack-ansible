#!/usr/bin/env python3
"""
IT-Stack INT-21: OpenKM ↔ Nextcloud WebDAV document bridge sync
Generated by Ansible template: openkm-nextcloud-bridge.py.j2

Mirrors documents under OpenKM /okm:root/shared/ to a Nextcloud WebDAV
folder, making them accessible to Nextcloud users via the Files app.
Only pushes new or modified files (ETag-based deduplication).
"""

import hashlib
import json
import logging
import os
import sys
import time
import urllib.request
import urllib.error
import urllib.parse
import xml.etree.ElementTree as ET
from datetime import datetime, timezone
from pathlib import Path

# ── Configuration ─────────────────────────────────────────────────────────────
OKM_BASE            = "{{ _openkm_api_url }}"
OKM_USER            = "{{ _openkm_admin_user }}"
OKM_PASS            = "{{ _openkm_admin_pass }}"
OKM_SOURCE_FOLDER   = "/okm:root/shared"

NC_DAV_ROOT         = "{{ _openkm_nc_url }}{{ _openkm_nc_dav_path }}"
NC_USER             = "{{ _openkm_nc_user }}"
NC_PASS             = "{{ _openkm_nc_pass }}"
NC_TARGET_PATH      = "{{ openkm_nextcloud_target_dir | default('OpenKM-Shared') }}"

STATE_FILE          = "/var/lib/openkm/nextcloud-bridge-state.json"
LOG_FILE            = "/var/log/openkm/nextcloud-bridge.log"
DRY_RUN             = {{ 'True' if openkm_nc_dry_run | default(false) else 'False' }}

os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s %(levelname)-8s %(message)s",
    handlers=[logging.FileHandler(LOG_FILE), logging.StreamHandler(sys.stdout)],
)
log = logging.getLogger("okm-nc-bridge")


def load_state() -> dict:
    if Path(STATE_FILE).exists():
        with open(STATE_FILE) as fh:
            return json.load(fh)
    return {}


def save_state(state: dict):
    with open(STATE_FILE, "w") as fh:
        json.dump(state, fh, indent=2)


def _basic_auth_header(user: str, passwd: str) -> str:
    import base64
    return "Basic " + base64.b64encode(f"{user}:{passwd}".encode()).decode()


def okm_login() -> str | None:
    req = urllib.request.Request(
        f"{OKM_BASE}/services/rest/auth/login",
        headers={"Authorization": _basic_auth_header(OKM_USER, OKM_PASS)},
    )
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:  # nosec B310
            token = resp.read().decode().strip().strip('"')
            return token or None
    except urllib.error.HTTPError as exc:
        log.error("OpenKM login failed: HTTP %s", exc.code)
        return None


def okm_list_folder(token: str, folder_path: str) -> list:
    header = {"Authorization": f"Bearer {token}", "Accept": "application/json"}
    url = f"{OKM_BASE}/services/rest/folder/getChildren?fldPath={urllib.parse.quote(folder_path)}"
    req = urllib.request.Request(url, headers=header)
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:  # nosec B310
            return json.loads(resp.read().decode())
    except urllib.error.HTTPError:
        return []


def okm_download_document(token: str, doc_path: str) -> bytes | None:
    url = f"{OKM_BASE}/services/rest/document/getContent?docPath={urllib.parse.quote(doc_path)}"
    req = urllib.request.Request(url, headers={"Authorization": f"Bearer {token}"})
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:  # nosec B310
            return resp.read()
    except urllib.error.HTTPError as exc:
        log.warning("OKM download %s → %s", doc_path, exc.code)
        return None


def nc_ensure_dir(path: str):
    url = f"{NC_DAV_ROOT}/{path}"
    req = urllib.request.Request(
        url,
        headers={"Authorization": _basic_auth_header(NC_USER, NC_PASS)},
        method="MKCOL",
    )
    try:
        urllib.request.urlopen(req, timeout=10)  # nosec B310
    except urllib.error.HTTPError as exc:
        if exc.code != 405:  # 405 = already exists
            log.warning("MKCOL %s → %s", path, exc.code)


def nc_put_file(path: str, data: bytes) -> bool:
    url = f"{NC_DAV_ROOT}/{path}"
    req = urllib.request.Request(
        url,
        data=data,
        headers={
            "Authorization": _basic_auth_header(NC_USER, NC_PASS),
            "Content-Type": "application/octet-stream",
        },
        method="PUT",
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:  # nosec B310
            return resp.status in (200, 201, 204)
    except urllib.error.HTTPError as exc:
        log.warning("PUT %s → %s", path, exc.code)
        return False


def sync_documents(token: str, okm_folder: str, nc_folder: str, state: dict) -> tuple[int, int]:
    pushed, errors = 0, 0
    items = okm_list_folder(token, okm_folder)

    for item in items:
        item_path = item.get("path", "")
        item_name = item_path.split("/")[-1]

        if item.get("type") == "folder":
            sub_nc = f"{nc_folder}/{item_name}"
            if not DRY_RUN:
                nc_ensure_dir(sub_nc)
            p, e = sync_documents(token, item_path, sub_nc, state)
            pushed += p
            errors += e
            continue

        data = okm_download_document(token, item_path)
        if data is None:
            errors += 1
            continue

        checksum = hashlib.md5(data).hexdigest()  # noqa: S324
        if state.get(item_path) == checksum:
            log.debug("Unchanged: %s", item_path)
            continue

        nc_path = f"{nc_folder}/{item_name}"
        if DRY_RUN:
            log.info("[DRY-RUN] Would push %s → %s", item_path, nc_path)
        elif nc_put_file(nc_path, data):
            state[item_path] = checksum
            log.info("Pushed: %s", nc_path)
            pushed += 1
        else:
            errors += 1
        time.sleep(0.2)

    return pushed, errors


def main():
    log.info("INT-21: OpenKM↔Nextcloud bridge — %s", datetime.now(timezone.utc).isoformat())

    token = okm_login()
    if not token:
        log.error("OpenKM login failed — aborting")
        sys.exit(1)

    if not DRY_RUN:
        nc_ensure_dir(NC_TARGET_PATH)

    state = load_state()
    pushed, errors = sync_documents(token, OKM_SOURCE_FOLDER, NC_TARGET_PATH, state)

    save_state(state)
    log.info("INT-21 complete — %d pushed, %d errors", pushed, errors)
    if errors:
        sys.exit(1)


if __name__ == "__main__":
    main()
