<?xml version="1.0" encoding="UTF-8"?>
<!--
  IT-Stack INT-22: Zabbix Mattermost Media Type
  Generated by Ansible template: zabbix-mattermost-media.xml.j2

  Import via: Zabbix UI → Administration → Media types → Import
  Or via API:  configuration.import (format: xml)
-->
<zabbix_export>
    <version>6.4</version>
    <media_types>
        <media_type>
            <name>IT-Stack Mattermost</name>
            <type>WEBHOOK</type>
            <parameters>
                <parameter>
                    <name>bot_name</name>
                    <value>Zabbix</value>
                </parameter>
                <parameter>
                    <name>channel</name>
                    <value>{{ _zabbix_mm_channel }}</value>
                </parameter>
                <parameter>
                    <name>webhook_url</name>
                    <value>{{ _zabbix_mm_webhook }}</value>
                </parameter>
                <parameter>
                    <name>event_nseverity</name>
                    <value>{EVENT.NSEVERITY}</value>
                </parameter>
                <parameter>
                    <name>event_name</name>
                    <value>{EVENT.NAME}</value>
                </parameter>
                <parameter>
                    <name>event_host</name>
                    <value>{HOST.NAME}</value>
                </parameter>
                <parameter>
                    <name>alert_message</name>
                    <value>{ALERT.MESSAGE}</value>
                </parameter>
                <parameter>
                    <name>zabbix_url</name>
                    <value>{{ zabbix_api_url | default('http://mon.lab.local:3000') }}</value>
                </parameter>
                <parameter>
                    <name>event_id</name>
                    <value>{EVENT.ID}</value>
                </parameter>
            </parameters>
            <script>
var Mattermost = {
    SEVERITY_COLORS: {
        "0": "#97AAB3", // Not classified
        "1": "#7499FF", // Information
        "2": "#FFC859", // Warning
        "3": "#FFA059", // Average
        "4": "#E97659", // High
        "5": "#E45959", // Disaster
    },

    sendAlert: function(params) {
        var color = this.SEVERITY_COLORS[params.event_nseverity] || "#97AAB3";
        var zabbix_url = params.zabbix_url +
            "/tr_events.php?triggerid={TRIGGER.ID}&amp;eventid=" + params.event_id;

        var payload = {
            channel: params.channel,
            username: params.bot_name,
            attachments: [{
                color: color,
                pretext: ":zap: *IT-Stack Infrastructure Alert*",
                title: params.event_name,
                title_link: zabbix_url,
                fields: [
                    { title: "Host",     value: params.event_host,    short: true },
                    { title: "Severity", value: params.alert_message, short: true },
                ],
                footer: "Zabbix → Mattermost (IT-Stack INT-22)",
                ts: Math.floor(Date.now() / 1000),
            }]
        };

        var req = new HttpRequest();
        req.addHeader("Content-Type: application/json");
        var resp = req.post(params.webhook_url, JSON.stringify(payload));
        if (req.getStatus() !== 200) {
            throw "Mattermost webhook failed: HTTP " + req.getStatus() + " " + resp;
        }
        return "OK";
    }
};

try {
    var params = JSON.parse(value);
    return Mattermost.sendAlert(params);
} catch (e) {
    throw "IT-Stack Mattermost media type error: " + e;
}
            </script>
            <timeout>10s</timeout>
            <description>IT-Stack INT-22: Forward Zabbix alerts to Mattermost incoming webhook</description>
            <message_templates>
                <message_template>
                    <event_source>TRIGGERS</event_source>
                    <operation_mode>PROBLEM</operation_mode>
                    <subject>Problem: {EVENT.NAME}</subject>
                    <message>Problem started at {EVENT.TIME} on {EVENT.DATE}
Host: {HOST.NAME} ({HOST.IP})
Severity: {EVENT.SEVERITY}
Trigger: {TRIGGER.NAME}
{TRIGGER.DESCRIPTION}</message>
                </message_template>
                <message_template>
                    <event_source>TRIGGERS</event_source>
                    <operation_mode>RECOVERY</operation_mode>
                    <subject>Resolved: {EVENT.NAME}</subject>
                    <message>Problem resolved at {EVENT.RECOVERY.TIME} on {EVENT.RECOVERY.DATE}
Host: {HOST.NAME} ({HOST.IP})
Duration: {EVENT.DURATION}</message>
                </message_template>
            </message_templates>
        </media_type>
    </media_types>
</zabbix_export>
