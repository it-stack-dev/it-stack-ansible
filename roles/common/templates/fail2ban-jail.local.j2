# /etc/fail2ban/jail.local — managed by Ansible (roles/common)
# {{ ansible_managed }}

[DEFAULT]
bantime  = 3600
findtime = 600
maxretry = 5
ignoreip = 127.0.0.1/8 ::1 {{ ufw_allowed_from_lan }}
backend  = systemd

[sshd]
enabled  = true
port     = {{ ssh_port }}
filter   = sshd
maxretry = 3
bantime  = 86400
