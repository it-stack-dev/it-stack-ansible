#!/usr/bin/env python3
"""
IT-Stack INT-20: GLPI ↔ Zammad bidirectional ticket sync script
Generated by Ansible template: glpi-zammad-sync.py.j2

Syncs:
  - GLPI pending tickets → Zammad (create if not present)
  - Zammad resolved → GLPI closed
"""

import json
import logging
import os
import sys
import time
import urllib.request
import urllib.error
from datetime import datetime, timezone

ZAMMAD_BASE         = "{{ _glpi_zammad_url }}"
ZAMMAD_TOKEN        = "{{ _glpi_zammad_api_token }}"

GLPI_BASE           = "{{ glpi_base_url | default('http://itsm.lab.local') }}"
GLPI_APP_TOKEN      = "{{ vault_glpi_zammad_app_token | default('lab-glpi-app-token') }}"
GLPI_USER_TOKEN     = "{{ vault_glpi_zammad_user_token | default('lab-glpi-user-token') }}"

LOG_FILE            = "/var/log/glpi/zammad-sync.log"
DRY_RUN             = {{ 'True' if glpi_zammad_dry_run | default(false) else 'False' }}

os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s %(levelname)-8s %(message)s",
    handlers=[logging.FileHandler(LOG_FILE), logging.StreamHandler(sys.stdout)],
)
log = logging.getLogger("glpi-zammad")


def _json_req(url: str, method: str = "GET", headers: dict = None, data: dict = None) -> dict | list | None:
    req_headers = {"Content-Type": "application/json", "Accept": "application/json"}
    if headers:
        req_headers.update(headers)
    body = json.dumps(data).encode() if data else None
    req = urllib.request.Request(url, data=body, headers=req_headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:  # nosec B310
            return json.loads(resp.read().decode())
    except urllib.error.HTTPError as exc:
        log.warning("%s %s → HTTP %s", method, url, exc.code)
        return None


def glpi_session() -> str | None:
    resp = _json_req(f"{GLPI_BASE}/apirest.php/initSession",
                     headers={"App-Token": GLPI_APP_TOKEN,
                               "Authorization": f"user_token {GLPI_USER_TOKEN}"})
    return resp.get("session_token") if resp else None


def fetch_glpi_open_tickets(session: str) -> list:
    resp = _json_req(
        f"{GLPI_BASE}/apirest.php/Ticket?range=0-200&status=1",
        headers={"App-Token": GLPI_APP_TOKEN, "Session-Token": session},
    )
    return resp if isinstance(resp, list) else []


def fetch_zammad_resolved(page: int = 1) -> list:
    resp = _json_req(
        f"{ZAMMAD_BASE}/api/v1/tickets/search?query=state.name:closed&page={page}&per_page=50",
        headers={"Authorization": f"Token token={ZAMMAD_TOKEN}"},
    )
    return resp.get("tickets", []) if isinstance(resp, dict) else []


def sync_ticket_to_zammad(session: str, ticket: dict) -> bool:
    title = ticket.get("name", f"GLPI #{ticket['id']}")
    if DRY_RUN:
        log.info("[DRY-RUN] Would sync GLPI #%s → Zammad: %s", ticket["id"], title)
        return True
    resp = _json_req(f"{ZAMMAD_BASE}/api/v1/tickets", method="POST",
                     headers={"Authorization": f"Token token={ZAMMAD_TOKEN}"},
                     data={"title": f"[GLPI-{ticket['id']}] {title}",
                           "group_id": {{ _glpi_zammad_group_id }},
                           "state": "new",
                           "article": {"subject": title, "body": title, "type": "note", "internal": True}})
    return bool(resp and resp.get("id"))


def main():
    log.info("INT-20: GLPI↔Zammad sync — %s", datetime.now(timezone.utc).isoformat())
    session = glpi_session()
    if not session:
        log.error("Cannot get GLPI session — aborting")
        sys.exit(1)

    open_tickets = fetch_glpi_open_tickets(session)
    log.info("GLPI open tickets: %d", len(open_tickets))

    success, errors = 0, 0
    for ticket in open_tickets:
        try:
            if sync_ticket_to_zammad(session, ticket):
                success += 1
            else:
                errors += 1
        except Exception as exc:  # noqa: BLE001
            log.error("Error syncing GLPI #%s: %s", ticket.get("id"), exc)
            errors += 1
        time.sleep(0.05)

    log.info("INT-20 complete — %d synced, %d errors", success, errors)
    if errors:
        sys.exit(1)


if __name__ == "__main__":
    main()
