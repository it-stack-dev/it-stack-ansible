<?php
/**
 * IT-Stack INT-20: GLPI → Zammad ticket escalation webhook handler
 * Generated by Ansible template: glpi-zammad-escalation.php.j2
 *
 * place at: {{ glpi_install_dir | default('/var/www/html/glpi') }}/plugins/int20/escalate_to_zammad.php
 * Called by a GLPI rule action (webhook or REST hook) when a ticket is escalated.
 *
 * POST body expected: { "ticket_id": <int>, "priority": <int 5=very high> }
 */

declare(strict_types=1);

// ── Configuration ─────────────────────────────────────────────────────────────
define('ZAMMAD_URL',       '{{ _glpi_zammad_url }}');
define('ZAMMAD_TOKEN',     '{{ _glpi_zammad_api_token }}');
define('ZAMMAD_GROUP_ID',  (int)'{{ _glpi_zammad_group_id }}');
define('GLPI_SQL_DSN',     'mysql:host={{ glpi_db_host | default("127.0.0.1") }};dbname={{ glpi_db_name | default("glpi") }};charset=utf8mb4');
define('GLPI_SQL_USER',    '{{ glpi_db_user | default("glpi") }}');
define('GLPI_SQL_PASS',    '{{ vault_glpi_db_pass | default("Lab20GlpiDB!") }}');
define('LOG_FILE',         '/var/log/glpi/zammad-escalation.log');

// ── Helpers ───────────────────────────────────────────────────────────────────
function log_msg(string $level, string $msg): void {
    $ts  = date('c');
    $line = "$ts $level $msg\n";
    file_put_contents(LOG_FILE, $line, FILE_APPEND | LOCK_EX);
    if ($level === 'ERROR') error_log($line);
}

function zammad_post(string $path, array $data): ?array {
    $url     = ZAMMAD_URL . $path;
    $payload = json_encode($data, JSON_THROW_ON_ERROR);
    $ch      = curl_init($url);
    curl_setopt_array($ch, [
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_POST           => true,
        CURLOPT_POSTFIELDS     => $payload,
        CURLOPT_HTTPHEADER     => [
            'Content-Type: application/json',
            'Accept: application/json',
            'Authorization: Token token=' . ZAMMAD_TOKEN,
        ],
        CURLOPT_TIMEOUT        => 10,
        CURLOPT_SSL_VERIFYPEER => false,
    ]);
    $resp   = curl_exec($ch);
    $status = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);
    if ($resp === false || $status >= 400) {
        log_msg('WARN', "Zammad POST $path → HTTP $status");
        return null;
    }
    return json_decode($resp, true, 512, JSON_THROW_ON_ERROR);
}

function fetch_glpi_ticket(int $ticket_id): ?array {
    try {
        $pdo  = new PDO(GLPI_SQL_DSN, GLPI_SQL_USER, GLPI_SQL_PASS,
                        [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]);
        $stmt = $pdo->prepare('SELECT id, name, content, priority, date FROM glpi_tickets WHERE id = :id');
        $stmt->execute([':id' => $ticket_id]);
        return $stmt->fetch(PDO::FETCH_ASSOC) ?: null;
    } catch (PDOException $e) {
        log_msg('ERROR', 'DB error: ' . $e->getMessage());
        return null;
    }
}

function glpi_priority_to_zammad(int $priority): int {
    // GLPI: 1=very low … 6=very high → map to Zammad priority IDs 1-3
    return match(true) {
        $priority >= 5 => 3, // high
        $priority >= 3 => 2, // normal
        default        => 1, // low
    };
}

// ── Main ──────────────────────────────────────────────────────────────────────
http_response_code(200);
header('Content-Type: application/json');

$raw    = file_get_contents('php://input');
$body   = json_decode($raw ?: '{}', true) ?? [];
$tid    = (int)($body['ticket_id'] ?? ($_GET['ticket_id'] ?? 0));

if ($tid <= 0) {
    log_msg('WARN', 'Missing ticket_id in request');
    echo json_encode(['ok' => false, 'error' => 'missing ticket_id']);
    exit;
}

log_msg('INFO', "Escalating GLPI ticket #$tid to Zammad");

$ticket = fetch_glpi_ticket($tid);
if (!$ticket) {
    log_msg('ERROR', "GLPI ticket #$tid not found");
    echo json_encode(['ok' => false, 'error' => 'ticket not found']);
    exit;
}

$zammad_ticket = zammad_post('/api/v1/tickets', [
    'title'       => "[GLPI-$tid] {$ticket['name']}",
    'group_id'    => ZAMMAD_GROUP_ID,
    'priority_id' => glpi_priority_to_zammad((int)$ticket['priority']),
    'state'       => 'new',
    'note'        => "Escalated from GLPI ticket #{$tid}\n\n{$ticket['content']}",
    'article'     => [
        'subject' => "Escalated from GLPI #$tid",
        'body'    => $ticket['content'] ?? '(no body)',
        'type'    => 'note',
        'internal' => true,
    ],
]);

if ($zammad_ticket && isset($zammad_ticket['id'])) {
    log_msg('INFO', "Zammad ticket #{$zammad_ticket['id']} created for GLPI #$tid");
    echo json_encode(['ok' => true, 'zammad_id' => $zammad_ticket['id']]);
} else {
    log_msg('ERROR', "Failed to create Zammad ticket for GLPI #$tid");
    echo json_encode(['ok' => false, 'error' => 'zammad create failed']);
}
