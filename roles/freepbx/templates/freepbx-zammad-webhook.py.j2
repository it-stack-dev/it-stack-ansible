#!/usr/bin/env python3
"""
freepbx-zammad-webhook.py — INT-10 Zammad Ticket AGI Script

FreePBX AGI script: creates / updates Zammad tickets for phone calls.
Called from: freepbx-zammad-webhook.conf dialplan macros.

Generated by: it-stack-ansible roles/freepbx/templates/freepbx-zammad-webhook.py.j2
"""

import sys
import json
import urllib.request
import urllib.error
from datetime import datetime

# ── Configuration (rendered by Ansible) ──────────────────────────────────────
ZAMMAD_URL        = "{{ _freepbx_zammad_url }}"
ZAMMAD_API_TOKEN  = "{{ _freepbx_zammad_api_token }}"
ZAMMAD_GROUP      = "{{ _freepbx_zammad_ticket_group }}"
VERIFY_TLS        = {{ 'True' if freepbx_tls_verify | default(false) else 'False' }}
FREEPBX_HOST      = "{{ ansible_hostname | default('freepbx') }}"

# ── AGI I/O helpers ───────────────────────────────────────────────────────────
def read_agi_env() -> dict:
    """Read AGI environment variables from stdin (key: value lines)."""
    env = {}
    while True:
        try:
            line = sys.stdin.readline().strip()
        except Exception:
            break
        if not line:
            break
        if ":" in line:
            key, _, val = line.partition(":")
            env[key.strip()] = val.strip()
    return env

def agi_set_variable(name: str, value: str) -> None:
    print(f"SET VARIABLE {name} {value}", flush=True)
    sys.stdin.readline()  # consume the response

def agi_result(success: bool) -> None:
    agi_set_variable("ZAMMAD_RESULT", "1" if success else "0")

# ── Zammad REST helpers ───────────────────────────────────────────────────────
def _api_request(method: str, path: str, payload: dict | None = None) -> dict:
    url = f"{ZAMMAD_URL}{path}"
    data = json.dumps(payload).encode("utf-8") if payload else None
    req = urllib.request.Request(
        url, data=data,
        headers={
            "Authorization": f"Token token={ZAMMAD_API_TOKEN}",
            "Content-Type": "application/json",
        },
        method=method,
    )
    try:
        import ssl
        ctx = ssl.create_default_context() if VERIFY_TLS else ssl._create_unverified_context()
        with urllib.request.urlopen(req, context=ctx, timeout=10) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        return {"_error": str(exc), "_code": exc.code}
    except Exception as exc:
        return {"_error": str(exc)}

# ── Action: create_ticket ────────────────────────────────────────────────────
def create_ticket(caller: str, callee: str, direction: str, start_epoch: str) -> bool:
    """Create a Zammad phone ticket for an inbound or outbound call."""
    start_ts = (
        datetime.utcfromtimestamp(float(start_epoch)).strftime("%Y-%m-%d %H:%M:%S UTC")
        if start_epoch.isdigit()
        else start_epoch
    )
    subject = f"Phone {direction.capitalize()}: {caller} → {callee}"
    body = (
        "Automatic ticket created by FreePBX CTI (INT-10)\n\n"
        f"Direction : {direction}\n"
        f"Caller    : {caller}\n"
        f"Callee    : {callee}\n"
        f"Started   : {start_ts}\n"
        f"PBX Host  : {FREEPBX_HOST}\n"
    )
    result = _api_request("POST", "/api/v1/tickets", {
        "title": subject,
        "group": ZAMMAD_GROUP,
        "state": "new",
        "priority": "2 normal",
        "article": {
            "subject": subject,
            "body": body,
            "type": "phone",
            "internal": False,
            "sender": "Agent",
        },
        "customer_id": "guess:anonymous",
        "tags": f"freepbx,{direction},cti-int10",
    })
    return "id" in result

# ── Action: update_ticket ────────────────────────────────────────────────────
def update_ticket(caller: str, callee: str, duration_secs: str) -> bool:
    """
    Append call duration to the most-recent open phone ticket for this caller.
    Searches for a matching ticket tagged 'freepbx' and posts a note.
    """
    search = _api_request(
        "GET",
        f"/api/v1/tickets/search?query=tags%3Afreepbx+title%3A{urllib.parse.quote(caller)}&limit=1",
    )
    tickets = search.get("tickets", [])
    if not tickets:
        return True  # no ticket to update — not an error

    ticket_id = tickets[0]
    note = (
        f"Call ended — duration: {duration_secs}s\n"
        f"Caller: {caller}  Callee: {callee}\n"
        "(automated update by FreePBX CTI INT-10)"
    )
    result = _api_request("POST", "/api/v1/ticket_articles", {
        "ticket_id": ticket_id,
        "body": note,
        "type": "note",
        "internal": True,
        "sender": "Agent",
    })
    return "id" in result

# ── Entry point ───────────────────────────────────────────────────────────────
def main() -> None:
    import urllib.parse  # needed by update_ticket
    globals()["urllib"].parse = urllib.parse

    _env = read_agi_env()  # consume AGI preamble

    args = sys.argv[1:]
    if not args:
        agi_result(False)
        return

    action = args[0]
    params = args[1:]

    if action == "create_ticket" and len(params) >= 4:
        ok = create_ticket(params[0], params[1], params[2], params[3])
    elif action == "update_ticket" and len(params) >= 3:
        ok = update_ticket(params[0], params[1], params[2])
    else:
        ok = False  # unknown action

    agi_result(ok)

if __name__ == "__main__":
    main()
