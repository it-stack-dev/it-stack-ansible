; =============================================================================
; freepbx-zammad-webhook.conf — INT-10 FreePBX ↔ Zammad phone ticket webhook
; Auto-creates Zammad tickets for inbound/outbound phone calls via AGI.
; Generated by: it-stack-ansible roles/freepbx/templates/freepbx-zammad-webhook.conf.j2
; =============================================================================

; ── Global variables ─────────────────────────────────────────────────────────
[zammad-webhook-globals]
ZAMMAD_URL={{ _freepbx_zammad_url }}
ZAMMAD_API_TOKEN={{ _freepbx_zammad_api_token }}
ZAMMAD_TICKET_GROUP={{ _freepbx_zammad_ticket_group }}
ZAMMAD_AGI={{ _freepbx_zammad_agi_path }}

; ── Macro: Create Zammad phone ticket ────────────────────────────────────────
; Args: ARG1=caller_id  ARG2=callee_did  ARG3=direction(inbound|outbound)
;       ARG4=start_epoch
[macro-zammad-phone-ticket]
exten => s,1,NoOp(INT-10: Zammad ticket for ${ARG1} → ${ARG2} [${ARG3}])
 same => n,Set(ZAMMAD_CALLER=${ARG1})
 same => n,Set(ZAMMAD_CALLEE=${ARG2})
 same => n,Set(ZAMMAD_DIR=${ARG3})
 same => n,Set(ZAMMAD_EPOCH=${ARG4})
 same => n,AGI(${ZAMMAD_AGI},create_ticket,${ZAMMAD_CALLER},${ZAMMAD_CALLEE},${ZAMMAD_DIR},${ZAMMAD_EPOCH})
 same => n,GotoIf($["${ZAMMAD_RESULT}" = "1"]?ticket_ok)
 same => n,NoOp(WARNING: Zammad ticket creation failed for ${CALLERID(num)})
 same => n(ticket_ok),Return()

; ── Macro: Update Zammad ticket at call end ───────────────────────────────────
; Args: ARG1=caller_id  ARG2=callee_did  ARG3=duration_seconds
[macro-zammad-call-complete]
exten => s,1,NoOp(INT-10: Zammad call complete: duration=${ARG3}s)
 same => n,AGI(${ZAMMAD_AGI},update_ticket,${ARG1},${ARG2},${ARG3})
 same => n,Return()

; ── Zammad inbound call notify context ──────────────────────────────────────
; Include in incoming dialplan to auto-create a ticket for every inbound call.
; Usage in incoming context: Gosub(zammad-inbound-notify,${EXTEN},1)
[zammad-inbound-notify]
exten => _X.,1,NoOp(INT-10: Inbound call from ${CALLERID(num)} to ${EXTEN})
 same => n,Macro(zammad-phone-ticket,${CALLERID(num)},${EXTEN},inbound,${EPOCH})
 same => n,Return()

; ── Zammad outbound call complete hook ──────────────────────────────────────
; Call at hangup of outbound leg to append call duration to Zammad ticket.
[zammad-outbound-complete]
exten => _X.,1,NoOp(INT-10: Outbound complete ${CALLERID(num)} → ${EXTEN} dur=${CDR(duration)}s)
 same => n,Macro(zammad-call-complete,${CALLERID(num)},${EXTEN},${CDR(duration)})
 same => n,Return()
