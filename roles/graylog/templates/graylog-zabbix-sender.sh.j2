#!/usr/bin/env bash
# IT-Stack INT-23: Graylog → Zabbix alert sender script
# Generated by Ansible template: graylog-zabbix-sender.sh.j2
#
# Called by the Graylog HTTP notification webhook (listen on 127.0.0.1:19000)
# OR invoked directly:  graylog-zabbix-sender.sh <key> <value> [host]
#
# Usage as standalone HTTP micro-server (port 19000):
#   Start: graylog-zabbix-sender.sh --serve &
#
# Zabbix trapper item key:  graylog.alert
# Zabbix host:              {{ _graylog_zabbix_proxy_host }}

set -euo pipefail

ZABBIX_SERVER="{{ _graylog_zabbix_host }}"
ZABBIX_PORT="{{ _graylog_zabbix_port }}"
ZABBIX_HOST="{{ _graylog_zabbix_proxy_host }}"
ZABBIX_KEY="graylog.alert"
LOG_FILE="/var/log/graylog/zabbix-alerts.log"
LISTEN_PORT="19000"

mkdir -p "$(dirname "$LOG_FILE")"

log() { echo "$(date -u +%FT%TZ) $*" | tee -a "$LOG_FILE" >&2; }

send_trap() {
    local key="${1:-$ZABBIX_KEY}"
    local value="${2:-1}"
    local host="${3:-$ZABBIX_HOST}"

    log "INFO  sending trap: host=$host key=$key value=$value"
    if command -v zabbix_sender &>/dev/null; then
        zabbix_sender \
            -z "$ZABBIX_SERVER" \
            -p "$ZABBIX_PORT" \
            -s "$host" \
            -k "$key" \
            -o "$value" \
            >> "$LOG_FILE" 2>&1
        log "INFO  zabbix_sender exit=$?"
    else
        log "WARN  zabbix_sender not installed — trap dropped"
    fi
}

# ── HTTP micro-server mode ────────────────────────────────────────────────────
serve_mode() {
    log "INFO  Graylog→Zabbix sender listening on 127.0.0.1:$LISTEN_PORT"
    while true; do
        # Read one HTTP request from netcat
        request=$(echo -e "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nOK" \
            | nc -l -p "$LISTEN_PORT" -q 1 127.0.0.1 2>/dev/null || true)

        # Extract JSON body from POST (last non-empty line)
        body=$(echo "$request" | awk '/^\r?$/{found=1; next} found{print}' | tail -1)

        if [[ -n "$body" ]]; then
            log "INFO  received webhook payload: ${body:0:200}"
            # Parse alert level from Graylog payload (field: gl2_message or alert_condition_title)
            level=$(echo "$body" | python3 -c \
                "import sys,json; d=json.loads(sys.stdin.read()); \
                 print(d.get('check_result',{}).get('triggered',True))" 2>/dev/null || echo "True")
            value=$( [[ "$level" == "True" ]] && echo "1" || echo "0" )
            send_trap "$ZABBIX_KEY" "$value" "$ZABBIX_HOST"
        fi
    done
}

# ── Direct invocation mode ────────────────────────────────────────────────────
if [[ "${1:-}" == "--serve" ]]; then
    serve_mode
elif [[ $# -ge 2 ]]; then
    send_trap "$1" "$2" "${3:-$ZABBIX_HOST}"
else
    log "ERROR  Usage: $0 <key> <value> [host]  OR  $0 --serve"
    exit 1
fi
